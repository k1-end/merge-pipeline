# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=merge_pipeline
DB_USER=merge_pipeline
DB_PASSWORD=secure-password
DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Redis (Celery broker + result backend)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Credential encryption
# Generate with: python -m cryptocode  (or: openssl rand -base64 32)
# ---------------------------------------------------------------------------
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_64_CHARACTERS_BASE64_URLSAFE

# ---------------------------------------------------------------------------
# AI Providers (optional defaults, Phase 4)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FLEARNING_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000
OPENCODE_BINARY=opencode
OPENCODE_AGENT=review
OPENCODE_TIMEOUT_SECONDS=600
OPENCODE_MAX_OUTPUT_BYTES=1048576
# Optional isolated OpenCode config/data directory mounted into the worker.
OPENCODE_CONFIG_DIR=
# Docker-managed bare repository caches. Do not bind-mount this to a host checkout.
REPOSITORY_CACHE_ROOT=/var/lib/merge-pipeline/repositories

# ---------------------------------------------------------------------------
# Monitoring (optional, Phase 7)
# ---------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
